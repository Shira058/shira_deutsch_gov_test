{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // GlobalExceptionHandler logs every exception at the right level; this stops a duplicate error log per handled exception.
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "DataSources": {
    "UseMocks": true
  },
  "Cms": {
    "BaseUrl": "http://cms.internal/",
    "Timeout": "00:00:05"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?serverSelectionTimeoutMS=5000",
    "Database": "MuniSites"
  },
  "Normalization": {
    "DefaultMaxItems": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
